# ─── SUPABASE ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── STRIPE ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: second signing secret for Stripe Connect webhooks
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ─── EMAIL (Resend) — optional, emails are skipped if unset ─
RESEND_API_KEY=re_...
FROM_EMAIL=ChristLink <noreply@yourdomain.com>

# ─── APPLE WALLET PASSES — optional ────────────────────────
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_PASS_P12_BASE64=
APPLE_PASS_P12_PASSWORD=

# ─── APP ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (CORS)
APP_URL=https://your-app.up.railway.app
NODE_ENV=production
PORT=4242
